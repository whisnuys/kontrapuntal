---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDiscoverableNotes, getTopicNames } from '../../lib/content.ts';
import { formatLabel, topicHref } from '../../lib/presentation.ts';

const notes = await getDiscoverableNotes();
const topicNames = await getTopicNames();
const topics = [...new Set(notes.flatMap(({ data }) => data.topics))]
  .map((topic) => ({
    name: topic,
    notes: notes.filter(({ data }) => data.topics.includes(topic)),
  }))
  .sort((left, right) => right.notes.length - left.notes.length || left.name.localeCompare(right.name));
---

<BaseLayout title="Topics" description="Recurring subjects and questions across Kontrapuntal.">
  <div data-layout="topic-directory">
  <header class="page-header">
    <p class="eyebrow">Recurring questions</p>
    <div class="page-header__grid">
      <h1>Topics</h1>
      <p>Threads gather writing across formats. They are a map of recurring attention, not a rigid taxonomy.</p>
    </div>
  </header>

  <section class="shell topics-list" aria-label="All active topics">
    {topics.map(({ name, notes: topicNotes }, index) => (
      <a class="topic-index-item" href={topicHref(name)}>
        <span>{String(index + 1).padStart(2, '0')}</span>
        <h2>{topicNames.get(name) ?? formatLabel(name)}</h2>
        <p>{topicNotes.length} {topicNotes.length === 1 ? 'note' : 'notes'}</p>
        <span aria-hidden="true">↗</span>
      </a>
    ))}
  </section>
  </div>
</BaseLayout>
