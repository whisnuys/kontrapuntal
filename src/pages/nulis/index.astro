---
export const prerender = true;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <base href="/nulis/" />
    <link rel="icon" type="image/svg+xml" href="/favicon_kp/favicon.svg" />
    <link rel="stylesheet" href="/nulis/exit-modal.css" />
    <title>Kontrapuntal Editor</title>
    <script is:inline src="/nulis/exit-guard.js"></script>
  </head>
  <body>
    <script
      is:inline
      src="https://unpkg.com/decap-cms@3.15.1/dist/decap-cms.js"
      integrity="sha384-in6eHztHveqQ7uMZ1fDaKlDmacQLFuLH2wWrFTiymyuS8zQ5bixwL8U3AeRi8h/L"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    ></script>
    <script is:inline src="/nulis/init.js"></script>
    <script is:inline src="/nulis/preview.js"></script>
    <dialog class="admin-exit-dialog" id="admin-exit-dialog" aria-labelledby="admin-exit-title">
      <div class="admin-exit-dialog__content">
        <p class="admin-exit-dialog__eyebrow">Unsaved changes</p>
        <h2 id="admin-exit-title">Leave this entry?</h2>
        <p class="admin-exit-dialog__message">Your unpublished edits will be lost if you leave this page.</p>
        <div class="admin-exit-dialog__actions">
          <button class="admin-exit-dialog__keep" type="button" data-exit-dialog-cancel>Keep editing</button>
          <button class="admin-exit-dialog__leave" type="button" data-exit-dialog-confirm>Leave without saving</button>
        </div>
      </div>
    </dialog>
    <script is:inline src="/nulis/exit-modal.js"></script>
  </body>
</html>
