---
import { getTopicNames, type NoteEntry } from '../lib/content.ts';
import { getHomepageTopicPalette } from '../lib/homepage.ts';
import { topicHref } from '../lib/presentation.ts';
import HomepageStoryCard from './HomepageStoryCard.astro';

interface Props {
  topic: string;
  notes: NoteEntry[];
  index: number;
}

const { topic, notes, index } = Astro.props;
const topicNames = await getTopicNames();
const lead = notes[0];
const supporting = notes.slice(1, 4);
const headingId = `topic-band-${index}`;
const palette = getHomepageTopicPalette(topic);
const topicStyle = `--topic-band-bg: ${palette?.background ?? '#20211D'}; --topic-band-ink: ${palette?.foreground ?? '#ECE5D8'};`;
---

<section
  class="topic-band"
  data-topic={topic}
  style={topicStyle}
  aria-labelledby={headingId}
>
  <header class="topic-band__heading">
    <p class="eyebrow">Topic</p>
    <div>
      <h2 id={headingId}><a href={topicHref(topic)}>{topicNames.get(topic) ?? topic}</a></h2>
      <a class="text-link" href={topicHref(topic)}>
        More<span aria-hidden="true">→</span>
      </a>
    </div>
  </header>
  <div class="topic-band__grid">
    {lead && <HomepageStoryCard note={lead} variant="prominent" index={0} />}
    <div class="topic-band__supporting">
      {supporting.map((note, noteIndex) => (
        <HomepageStoryCard note={note} index={noteIndex + 1} />
      ))}
    </div>
  </div>
</section>
