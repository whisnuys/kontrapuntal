---
import { getTopicNames } from '../lib/content.ts';
import { topicHref } from '../lib/presentation.ts';

interface Props {
  topic: string;
}

const { topic } = Astro.props;
const topicNames = await getTopicNames();
---

<a class="topic-link" href={topicHref(topic)}>{topicNames.get(topic) ?? topic}</a>
