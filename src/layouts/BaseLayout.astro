---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
}

const {
  title,
  description = 'Kontrapuntal is an independent editorial notebook for essays, criticism, and notes in counterpoint.',
  image = '/images/kontrapuntal-og.png',
  noindex = false,
  type = 'website',
  publishedAt,
  updatedAt,
} = Astro.props;
const documentTitle = title ? `${title} — Kontrapuntal` : 'Kontrapuntal — Notes in counterpoint';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#151613" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon_kp/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Kontrapuntal" href="/feed.xml" />
    <link
      rel="preload"
      href="/fonts/newsreader-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:site_name" content="Kontrapuntal" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{documentTitle}</title>
    <slot name="head" />
  </head>
  <body class="site-frame">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader currentPath={Astro.url.pathname} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <script>
      const noteCards = Array.from(document.querySelectorAll<HTMLElement>('[data-note-reveal]'));
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (noteCards.length && !reducedMotion.matches && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries, currentObserver) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;

              entry.target.classList.remove('is-reveal-pending');
              currentObserver.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.1 },
        );

        noteCards.forEach((card, index) => {
          card.style.setProperty('--note-reveal-index', String(index % 3));
          const cardBounds = card.getBoundingClientRect();

          if (cardBounds.top >= window.innerHeight || cardBounds.bottom <= 0) {
            card.classList.add('is-reveal-pending');
            observer.observe(card);
          }
        });
      }
    </script>
  </body>
</html>
